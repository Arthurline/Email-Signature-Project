# Copy to .env and fill in. Never commit the real .env.

# Entra ID app registration
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000

# PEM file holding both the certificate and its private key (see certificate/README.md)
CERTIFICATE_PATH=certificate/signature-manager.pem

# Primary .onmicrosoft.com domain, used to connect to Exchange Online
EXCHANGE_ORGANIZATION=contoso.onmicrosoft.com

# Clients must send this in the X-API-Key header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Flask session signing key. Generate the same way as API_KEY.
SECRET_KEY=

# Server
HOST=127.0.0.1
PORT=5000
DEBUG=false
LOG_LEVEL=INFO

# Path to PowerShell 7
PWSH_PATH=pwsh
# Seconds to wait for each Exchange Online PowerShell run
EXCHANGE_TIMEOUT=600
